#!/bin/sh
# wayvnc-session - run wayvnc for the niri session. The first run creates the
# RSA-AES key and a config that asks for the user's own password (PAM).
# It listens everywhere; firewalld only lets it in on the NetBird interface.
set -eu
dir=${XDG_CONFIG_HOME:-$HOME/.config}/wayvnc
umask 077
mkdir -p "$dir"
if [ ! -f "$dir/rsa_key.pem" ]; then
  openssl genrsa -traditional -out "$dir/rsa_key.pem" 4096 2>/dev/null
fi
if [ ! -f "$dir/config" ]; then
  cat > "$dir/config" <<'EOF'
use_relative_paths=true
address=0.0.0.0
enable_auth=true
enable_pam=true
rsa_private_key_file=rsa_key.pem
xkb_layout=it
EOF
fi
exec wayvnc -C "$dir/config"
