[Unit]
Description=wayvnc VNC server (niri sessions only)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# Plasma starts graphical-session.target too; there KRDP serves RDP instead.
ExecCondition=/bin/sh -c 'test "$XDG_CURRENT_DESKTOP" = niri'
ExecStart=/usr/local/bin/wayvnc-session
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
